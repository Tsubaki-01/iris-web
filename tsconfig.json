{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client"],
    "noEmit": true
  },
  "include": ["site/.vitepress/**/*.ts", "site/.vitepress/**/*.vue", "scripts/**/*.mjs", "tests/**/*.ts", "playwright.config.ts"]
}
