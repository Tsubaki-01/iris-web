{
  "name": "iris-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "format": "prettier --write src tests scripts *.ts *.json index.html public/pcm-worklet.js",
    "format:check": "prettier --check src tests scripts *.ts *.json index.html public/pcm-worklet.js"
  },
  "dependencies": {
    "@codemirror/lang-yaml": "^6.1.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/noto-sans-sc": "^5.2.9",
    "@fontsource/dm-serif-display": "^5.2.8",
    "@tanstack/react-query": "^5.90.2",
    "@uiw/react-codemirror": "^4.25.2",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^27.0.0",
    "json-schema-to-typescript": "^15.0.4",
    "openapi-typescript": "^7.9.1",
    "prettier": "3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
